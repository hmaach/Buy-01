# Copy to infra/.env on the VM and chmod 600 it. The real .env is gitignored.
# Configuration as Code turns these values into Jenkins settings and credentials at every start.

# Jenkins admin. Use the username you already created by hand: its password is reset to this value.
JENKINS_ADMIN_ID=
# openssl rand -base64 24 | tr -d "/+="
JENKINS_ADMIN_PASSWORD=
# Public URL, used in emails and links
JENKINS_URL=https://jenkins.buy-01.duckdns.org/

# Fine-grained GitHub token, Buy-01 repository only (see infra/README.md for its permissions)
GITHUB_USER=
GITHUB_TOKEN=
# Shared secret of the GitHub webhook: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Build notifications by email. With Gmail: SMTP_USER is the address, SMTP_PASSWORD an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Who receives the build emails
NOTIFY_EMAIL=
