#################################
# GLOBAL
#################################
TZ=UTC
SPRING_PROFILES_ACTIVE=docker
# Gateway TLS keystore password, used at image build and at runtime: openssl rand -base64 24 | tr -d "/+="
SSL_PASSWORD=

#################################
# DISCOVERY SERVICE
#################################
# Eureka address for services run outside Docker (compose sets its own value)
EUREKA_URL=http://localhost:8761/eureka

#################################
# API GATEWAY
#################################
GATEWAY_PORT=8080

#################################
# SECURITY (USER SERVICE)
#################################
# Filled by make env (scripts/generate-keys.sh): base64 DER, PKCS#8 private and X.509 public
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000

#################################
# USER SERVICE
#################################
USER_MONGO_HOST=localhost
USER_MONGO_PORT=27017
USER_MONGO_DB=user_db
# Mongo root user; the password only applies when the volume is first created
USER_MONGO_USERNAME=
USER_MONGO_PASSWORD=

#################################
# PRODUCT SERVICE
#################################
PRODUCT_MONGO_HOST=localhost
# Mongo root user; the password only applies when the volume is first created
PRODUCT_MONGO_DB_USER=
PRODUCT_MONGO_DB_PWD=
PRODUCT_MONGO_DB_NAME=mongo-product
PRODUCT_MONGO_LOCAL_PORT=27019
PRODUCT_MONGO_DOCKER_PORT=27019

#################################
# MEDIA SERVICE
#################################
MEDIA_MONGO_HOST=localhost
# Mongo root user; the password only applies when the volume is first created
MEDIA_MONGO_DB_USER=
MEDIA_MONGO_DB_PWD=
MEDIA_MONGO_DB_NAME=mongo-media
MEDIA_MONGO_LOCAL_PORT=27018
MEDIA_MONGO_DOCKER_PORT=27018

#################################
# KAFKA
#################################
KAFKA_BROKER=kafka:9092

#################################
# RATE LIMIT
#################################
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_MINUTES=1