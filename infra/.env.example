# Copy to infra/.env on the CI VM. The real .env is gitignored.

# Jenkins admin created by Configuration as Code at every start
JENKINS_ADMIN_ID=
# openssl rand -base64 24 | tr -d "/+="
JENKINS_ADMIN_PASSWORD=
# Public URL of Jenkins, for links in emails and webhooks, for example https://ci.example.duckdns.org/
JENKINS_URL=

# Group id of the host docker group, so Jenkins can use the Docker socket: getent group docker | cut -d: -f3
DOCKER_GID=
